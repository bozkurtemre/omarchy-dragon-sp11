/upstream/

# Build outputs and anything carrying Microsoft, Qualcomm or Dolby files.
# build-iso.ps1 keeps these under %USERPROFILE%\sp11-omarchy-build, but never commit them.
*.iso
*.iso.sha256
*.iso.provenance.txt
*.efi
*.mbn
*.elf

# Staged by build-iso.ps1 next to the scripts: this machine's Windows driver archive and
# device facts. They go on the ISO, never into git.
windows/
device-facts.json
SHA256SUMS
