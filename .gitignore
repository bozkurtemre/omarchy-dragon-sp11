# Third-party checkouts used for research (see README "Kaynaklar")
/upstream/

# Build outputs and anything carrying Microsoft/Qualcomm firmware.
# build-iso.ps1 keeps these under %USERPROFILE%\sp11-omarchy-build, but never commit them.
*.iso
*.iso.sha256
*.efi
*.mbn
*.elf
firmware/

# Staged by build-iso.ps1 next to the scripts: official packages and this machine's
# Windows sensor configuration. They go on the ISO, never into git.
pkgs/
sensors/
