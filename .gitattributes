# These run under bash/python on Linux; a CRLF checkout (core.autocrlf=true) would break them,
# and build/remaster.sh refuses to put CRLF scripts on the ISO.
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
payload/sp11-lcd/README.md text eol=lf
payload/sp11-lcd/camera/** text eol=lf
payload/sp11-lcd/touchscreen/** text eol=lf
payload/sp11-lcd/ir-camera/** text eol=lf
Dockerfile text eol=lf
